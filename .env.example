# Supabase project (Settings → API). The publishable key is safe to expose in the browser;
# all data access is protected by Row Level Security in the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for end-to-end tests (GitHub Actions secrets, never commit real values)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
E2E_BASE_URL=http://localhost:4173
